+import pytest
+from datafusion import SessionContext, col, functions, lit
+
+
+@pytest.mark.parametrize("depth", [2, 12, 32])
+def test_successive_lambda_bindings(depth):
+    frame = SessionContext().from_pydict({"value": [1, 2, None]})
+    value = col("value")
+    for index in range(depth):
+        name = f"value{index}"
+        value = functions.array_element(
+            functions.array_transform(
+                functions.make_array(value),
+                functions.lambda_([name], functions.lambda_var(name) + lit(1)),
+            ),
+            1,
+        )
+    assert frame.select(value.alias("result")).to_pydict() == {
+        "result": [1 + depth, 2 + depth, None]
+    }
+
+
+def test_lambda_fields_follow_projection_types():
+    frame = SessionContext().from_pydict({"words": [["ab", "c", None], []]})
+    value = functions.lambda_var("first")
+    frame = frame.with_column(
+        "first",
+        functions.array_transform(
+            col("words"),
+            functions.lambda_(
+                ["first"],
+                functions.named_struct(
+                    [
+                        ("flag", functions.character_length(value) > lit(1)),
+                        ("word", value),
+                    ]
+                ),
+            ),
+        ),
+    )
+    value = functions.lambda_var("second")
+    frame = frame.with_column(
+        "second",
+        functions.array_transform(
+            col("first"),
+            functions.lambda_(
+                ["second"],
+                functions.named_struct(
+                    [("flag", value["flag"]), ("word", value["word"])]
+                ),
+            ),
+        ),
+    )
+    value = functions.lambda_var("third")
+    result = functions.array_transform(
+        col("second"), functions.lambda_(["third"], value["flag"])
+    )
+    assert frame.select(result.alias("result")).to_pydict() == {
+        "result": [[True, False, None], []]
+    }
+
+
+def test_nested_lambdas_preserve_captured_values():
+    frame = SessionContext().from_pydict({"offset": [1, 10]})
+    expression = functions.array_transform(
+        functions.make_array(lit(1), lit(2)),
+        functions.lambda_(
+            ["outer"],
+            functions.array_transform(
+                functions.make_array(lit(10), lit(20)),
+                functions.lambda_(
+                    ["inner"],
+                    functions.lambda_var("outer")
+                    + functions.lambda_var("inner")
+                    + col("offset"),
+                ),
+            ),
+        ),
+    )
+    assert frame.select(expression.alias("result")).to_pydict() == {
+        "result": [[[12, 22], [13, 23]], [[21, 31], [22, 32]]]
+    }
+
+
+def test_nested_lambdas_keep_shadowed_names_separate():
+    frame = SessionContext().from_pydict({"value": [1, 10]})
+    inner = functions.array_transform(
+        functions.make_array(lit(2)),
+        functions.lambda_(["item"], functions.lambda_var("item") + lit(1)),
+    )
+    expression = functions.array_transform(
+        functions.make_array(col("value")),
+        functions.lambda_(
+            ["item"], functions.lambda_var("item") + functions.array_element(inner, 1)
+        ),
+    )
+    assert frame.select(expression.alias("result")).to_pydict() == {
+        "result": [[4], [13]]
+    }
+
+
+def test_unnest_does_not_keep_row_number_unique():
+    frame = SessionContext().from_pydict({"items": [[1, 2], [1, 2], [3, 4]]})
+    frame = frame.with_column("row", functions.row_number()).unnest_columns("items")
+    frame = frame.aggregate(
+        [col("row")], [functions.array_agg(col("items")).alias("items_out")]
+    )
+    actual = sorted(
+        sorted(row["items_out"]) for row in frame.to_arrow_table().to_pylist()
+    )
+    assert actual == [[1, 2], [1, 2], [3, 4]]
+
+
+def test_nested_list_binding_resolves_before_type_coercion():
+    frame = SessionContext().from_pydict({"items": [[1, 2], []]})
+    records = functions.array_transform(
+        col("items"),
+        functions.lambda_(
+            ["item"],
+            functions.named_struct(
+                [
+                    ("number", functions.lambda_var("item")),
+                ]
+            ),
+        ),
+    )
+    values = functions.array_transform(
+        functions.make_array(records),
+        functions.lambda_(
+            ["records"],
+            functions.array_transform(
+                functions.lambda_var("records"),
+                functions.lambda_(["record"], functions.lambda_var("record")["number"]),
+            ),
+        ),
+    )
+    result = functions.array_element(values, 1)
+    assert frame.select(result.alias("result")).to_pydict() == {"result": [[1, 2], []]}
+
+
+@pytest.mark.parametrize("project", [False, True])
+def test_lambda_fields_follow_coerced_decimal_precision(project):
+    frame = SessionContext().from_pydict({"items": [[1, 2], []]})
+    records = functions.array_transform(
+        col("items"),
+        functions.lambda_(
+            ["item"],
+            functions.named_struct(
+                [("count", lit(0) - functions.cardinality(col("items")))]
+            ),
+        ),
+    )
+    if project:
+        frame = frame.with_column("records", records)
+        records = col("records")
+    result = functions.array_transform(
+        records,
+        functions.lambda_(["record"], functions.lambda_var("record")["count"]),
+    )
+    assert frame.select(result.alias("result")).to_pydict() == {
+        "result": [[-2, -2], []]
+    }
