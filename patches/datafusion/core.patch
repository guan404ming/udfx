+use std::sync::Arc;
+
+use arrow::array::RecordBatch;
+use arrow::datatypes::{DataType, Field, Schema};
+use datafusion::assert_batches_eq;
+use datafusion::dataframe::DataFrame;
+use datafusion::prelude::SessionContext;
+use datafusion_common::{Result, ToDFSchema};
+use datafusion_expr::simplify::SimplifyContext;
+use datafusion_expr::{Expr, col, lambda, lambda_var, lit};
+use datafusion_functions::core::expr_fn::{get_field, named_struct};
+use datafusion_functions_aggregate::expr_fn::array_agg;
+use datafusion_functions_nested::expr_fn::{array_element, array_transform, make_array};
+use datafusion_functions_window::expr_fn::row_number;
+use datafusion_optimizer::simplify_expressions::ExprSimplifier;
+
+async fn execute(frame: DataFrame) -> Result<Vec<RecordBatch>> {
+    let (state, plan) = frame.into_parts();
+    let plan = plan.resolve_lambda_variables()?.data;
+    DataFrame::new(state, plan).collect().await
+}
+
+#[tokio::test]
+async fn successive_lambda_bindings() -> Result<()> {
+    let context = SessionContext::new();
+    let frame = context.sql("SELECT 1 AS value UNION ALL SELECT 2").await?;
+    let mut value = col("value");
+    for index in 0..32 {
+        let name = format!("element{index}");
+        value = array_element(
+            array_transform(
+                make_array(vec![value]),
+                lambda([name.as_str()], lambda_var(name.as_str()) + lit(1)),
+            ),
+            lit(1),
+        );
+    }
+    let result = execute(frame.select(vec![value.alias("value")])?).await?;
+    assert_batches_eq!(
+        [
+            "+-------+",
+            "| value |",
+            "+-------+",
+            "| 33    |",
+            "| 34    |",
+            "+-------+"
+        ],
+        &result
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn fields_follow_child_projection_types() -> Result<()> {
+    let context = SessionContext::new();
+    let frame = context.sql("SELECT [1, 2] AS values").await?;
+    let first = array_transform(
+        col("values"),
+        lambda(
+            ["first"],
+            named_struct(vec![lit("value"), lambda_var("first")]),
+        ),
+    );
+    let second = array_transform(
+        col("first"),
+        lambda(
+            ["second"],
+            named_struct(vec![lit("value"), get_field(lambda_var("second"), "value")]),
+        ),
+    );
+    let third = array_transform(
+        col("second"),
+        lambda(["third"], get_field(lambda_var("third"), "value")),
+    );
+    let frame = frame
+        .with_column("first", first)?
+        .with_column("second", second)?;
+    let result = execute(frame.select(vec![third.alias("values")])?).await?;
+    assert_batches_eq!(
+        [
+            "+--------+",
+            "| values |",
+            "+--------+",
+            "| [1, 2] |",
+            "+--------+"
+        ],
+        &result
+    );
+    Ok(())
+}
+
+#[test]
+fn bound_variables_do_not_repeat_constant_evaluation() -> Result<()> {
+    let schema = Schema::new(vec![Field::new(
+        "values",
+        DataType::List(Arc::new(Field::new("item", DataType::Int64, true))),
+        true,
+    )])
+    .to_dfschema_ref()?;
+    let expression = array_transform(
+        col("values"),
+        lambda(["element"], lambda_var("element") + lit(1_i64)),
+    )
+    .resolve_lambda_variables(&schema)?
+    .data;
+    let simplifier =
+        ExprSimplifier::new(SimplifyContext::builder().with_schema(schema).build());
+    let (result, cycles) =
+        simplifier.simplify_with_cycle_count_transformed(expression)?;
+    assert!(!result.transformed);
+    assert_eq!(cycles, 1);
+    Ok(())
+}
+
+#[tokio::test]
+async fn constant_lambdas_keep_captures_and_shadowing() -> Result<()> {
+    let context = SessionContext::new();
+    context
+        .sql("SET datafusion.sql_parser.dialect = databricks")
+        .await?;
+    for (query, expected) in [
+        (
+            "SELECT array_transform([1, 2], x -> x + 1) AS value",
+            "| [2, 3]               |",
+        ),
+        (
+            "SELECT array_transform([1, 2], x -> array_transform([10], y -> x + y)) AS value",
+            "| [[11], [12]]         |",
+        ),
+        (
+            "SELECT array_transform([1, 2], x -> x + array_element(array_transform([10], x -> x + 1), 1)) AS value",
+            "| [12, 13]             |",
+        ),
+    ] {
+        let frame = context.sql(query).await?;
+        let plan = frame.into_optimized_plan()?;
+        assert!(plan.expressions().iter().all(|expression| {
+            matches!(expression.clone().unalias(), Expr::Literal(_, _))
+        }));
+        let result = DataFrame::new(context.state(), plan).collect().await?;
+        let text = arrow::util::pretty::pretty_format_batches(&result)?.to_string();
+        assert!(text.contains(expected.trim_matches('|').trim()));
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn unnest_removes_unique_row_dependence() -> Result<()> {
+    let context = SessionContext::new();
+    let frame = context
+        .sql("SELECT [1, 2] AS items UNION ALL SELECT [1, 2]")
+        .await?;
+    let frame = frame
+        .with_column("row", row_number())?
+        .unnest_columns(&["items"])?;
+    let result = frame
+        .aggregate(
+            vec![col("row")],
+            vec![array_agg(col("items")).alias("items")],
+        )?
+        .select_columns(&["items"])?
+        .collect()
+        .await?;
+    assert_batches_eq!(
+        [
+            "+--------+",
+            "| items  |",
+            "+--------+",
+            "| [1, 2] |",
+            "| [1, 2] |",
+            "+--------+"
+        ],
+        &result
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn nested_list_binding_resolves_before_type_coercion() -> Result<()> {
+    let context = SessionContext::new();
+    let frame = context.sql("SELECT [1, 2] AS items").await?;
+    let records = array_transform(
+        col("items"),
+        lambda(
+            ["item"],
+            named_struct(vec![lit("number"), lambda_var("item")]),
+        ),
+    );
+    let values = array_transform(
+        make_array(vec![records]),
+        lambda(
+            ["records"],
+            array_transform(
+                lambda_var("records"),
+                lambda(["record"], get_field(lambda_var("record"), "number")),
+            ),
+        ),
+    );
+    let result = frame
+        .select(vec![array_element(values, lit(1)).alias("items")])?
+        .collect()
+        .await?;
+    assert_batches_eq!(
+        [
+            "+--------+",
+            "| items  |",
+            "+--------+",
+            "| [1, 2] |",
+            "+--------+"
+        ],
+        &result
+    );
+    Ok(())
+}
